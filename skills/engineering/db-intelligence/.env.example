# MySQL Intelligence - Database Configuration
# Copy this file to .env and fill in your actual credentials
# The .env file will be loaded automatically by scripts

# ===== DATABASE CONNECTION 1 =====
DB1_HOST=localhost
DB1_PORT=3306
DB1_USER=your_username
DB1_PASSWORD=your_password
DB1_DATABASE=your_database
DB1_NAME=primary  # Friendly name for this connection

# ===== DATABASE CONNECTION 2 (Optional) =====
# DB2_HOST=localhost
# DB2_PORT=3306
# DB2_USER=your_username
# DB2_PASSWORD=your_password
# DB2_DATABASE=your_database
# DB2_NAME=secondary

# ===== DATABASE CONNECTION 3 (Optional) =====
# DB3_HOST=localhost
# DB3_PORT=3306
# DB3_USER=your_username
# DB3_PASSWORD=your_password
# DB3_DATABASE=your_database
# DB3_NAME=tertiary

# Notes:
# - At least DB1 must be configured
# - DB2 and DB3 are optional (uncomment to use)
# - DATABASE can be left empty to connect without selecting a schema
# - NAME is used to identify the connection in multi-DB queries
