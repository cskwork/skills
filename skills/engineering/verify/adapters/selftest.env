# verify skill — adapter for the self-test server.
#
# Points at scripts/selftest/server.py. Used by scripts/selftest.sh to prove
# the harness plumbing works without any real service. Also the shortest
# complete example of an adapter.

VERIFY_BUILD_CMD="python3 -c 'import ast,sys; ast.parse(open(\"scripts/selftest/server.py\").read()); print(\"parsed\")'"

# stdin-eater is first on purpose. It reads stdin the way gradle, mvn, and npm
# do. If the runner feeds the command list on stdin, this check swallows the two
# after it and the gate passes on work it never ran.
VERIFY_STATIC_CMDS="
stdin-eater|cat > /dev/null; echo 'this check reads stdin'
bash-syntax|for f in scripts/*.sh; do bash -n \"\$f\" || exit 1; done; echo 'all scripts parse'
python-syntax|python3 -m py_compile scripts/selftest/server.py && echo 'server.py compiles'
"

VERIFY_BASE_URL="http://127.0.0.1:${SELFTEST_PORT:-8778}"
VERIFY_HEALTH_PATH="/health"
VERIFY_HEALTH_TIMEOUT=20
VERIFY_RUN_CMD="python3 scripts/selftest/server.py ${SELFTEST_PORT:-8778} &"

VERIFY_TOKEN_MODE="http_post_json"
VERIFY_TOKEN_URL="/auth/login"
VERIFY_TOKEN_BODY='{"username":"dev@example.com","password":"changeme"}'
VERIFY_TOKEN_JQ=".data.accessToken"
VERIFY_TOKEN_HEADER_NAME="Authorization"
VERIFY_TOKEN_HEADER_PREFIX="Bearer "
VERIFY_TOKEN_TTL=300
VERIFY_TOKEN_SUBJECT="dev@example.com"

VERIFY_ACCOUNT_HOWTO="The self-test server hardcodes one account. Nothing to provision."

VERIFY_CALL_TIMEOUT=10
VERIFY_REPORT_LANG="en"
