# verify skill — adapter template.
#
# An adapter holds the facts about one stack that the gates cannot guess.
# Copy this file, fill it in, and save it as either:
#
#   <target-repo>/.verify/adapter.env      per repo, found automatically
#   <skill>/adapters/<name>.env            shipped, selected by VERIFY_ADAPTER=<name>
#
# It is sourced by bash. Only VERIFY_* assignments belong here.
# Never put a real credential in a file you commit.

# ==========================================================================
# Gate 1 — build
# ==========================================================================

# The cheapest command that proves the changed code compiles. Prefer a
# compile-only task over a full build with tests: gate 4 is where behaviour
# gets proved, and a 6-minute test suite here slows every iteration.
VERIFY_BUILD_CMD="./gradlew compileJava --offline"

# ==========================================================================
# Gate 2 — static checks
#
# Newline-separated "label|command" lines. Use only tools this repo already
# owns. Scope each one to the changed files where the tool supports it.
# A tool that is not installed records BLOCKED, never PASS.
# ==========================================================================

VERIFY_STATIC_CMDS="
compile|./gradlew compileJava compileTestJava --offline
xml-parse|find src/main/resources -name '*.xml' -print0 | xargs -0 -n1 xmllint --noout
"

# ==========================================================================
# Gate 4a — the running service
# ==========================================================================

# Base URL including port and context path prefix, no trailing slash.
VERIFY_BASE_URL="http://localhost:8080"

# Appended to VERIFY_BASE_URL. Any 2xx or 3xx counts as up.
VERIFY_HEALTH_PATH="/actuator/health"

# How to start it locally. Documentation only — the agent runs this, not the
# scripts, because a long-lived process needs the agent's own job control.
VERIFY_RUN_CMD="./gradlew bootRun --args='--spring.profiles.active=local'"

# Seconds to wait for health before declaring the gate BLOCKED.
VERIFY_HEALTH_TIMEOUT=120

# ==========================================================================
# Gate 4b — token
#
# VERIFY_TOKEN_MODE picks the acquisition strategy:
#
#   static           VERIFY_TOKEN_STATIC holds the token. Good for a CI secret.
#   http_get         GET VERIFY_TOKEN_URL with VERIFY_TOKEN_QUERY.
#   http_post_json   POST VERIFY_TOKEN_URL with VERIFY_TOKEN_BODY as JSON.
#   http_post_form   POST VERIFY_TOKEN_URL with VERIFY_TOKEN_BODY as a form.
#   command          Run VERIFY_TOKEN_COMMAND; its stdout is the token or the
#                    JSON to extract from. Use this for a browser login, an
#                    OAuth device flow, or a cloud CLI.
# ==========================================================================

VERIFY_TOKEN_MODE="http_post_json"

# Full URL, or a path appended to VERIFY_BASE_URL.
VERIFY_TOKEN_URL="/auth/login"

# For http_get, or extra params on a POST. Raw query string, no leading "?".
VERIFY_TOKEN_QUERY=""

# For the POST modes. JSON object, or form-encoded pairs.
VERIFY_TOKEN_BODY='{"username":"dev@example.com","password":"changeme"}'

# For command mode.
# VERIFY_TOKEN_COMMAND="node scripts/get-token.js"

# Extra headers on the token call. Newline-separated "Name: value" lines.
VERIFY_TOKEN_EXTRA_HEADERS=""

# Where the token sits in the response, as a jq path. Leave empty when the
# whole response body is the token.
VERIFY_TOKEN_JQ=".data.accessToken"

# How the token is presented on later calls.
VERIFY_TOKEN_HEADER_NAME="Authorization"
VERIFY_TOKEN_HEADER_PREFIX="Bearer "

# Cache lifetime in seconds. Set it below the real expiry, so a long suite
# does not die halfway on a 401.
VERIFY_TOKEN_TTL=1500

# Anything that changes the identity being requested. Include it here so the
# cache key changes when the subject changes.
VERIFY_TOKEN_SUBJECT="dev@example.com"

# ==========================================================================
# Gate 4c — accounts
#
# Documentation for the agent. When the token call needs a user, group, or
# tenant that does not exist, this is what to run and what it needs.
# ==========================================================================

VERIFY_ACCOUNT_HOWTO="No account provisioning documented for this stack yet."

# ==========================================================================
# Calls
# ==========================================================================

# Headers added to every scenario call. Newline-separated "Name: value".
VERIFY_EXTRA_HEADERS=""

VERIFY_CALL_TIMEOUT=30

# Extra redaction, as newline-separated sed expressions. Use this for any
# identifier in this stack that must not reach a receipt.
VERIFY_REDACT_EXTRA=""

# Hosts this skill must never call, as one extended regex. Enforced by
# scripts/lib.sh vf_guard_target before curl runs. Fill in your production
# hostnames — this is the one guard against a mistake no verdict can undo.
VERIFY_FORBIDDEN_HOSTS=""

# ==========================================================================
# Gate 5 — report
# ==========================================================================

# Where the ubiquitous language lives, so the report uses the team's words.
VERIFY_GLOSSARY_PATHS="CONTEXT.md
docs/adr/
GLOSSARY.md"

# Report language. Any value other than "en" makes the report body use that
# language while code identifiers, paths, and error strings stay unchanged.
VERIFY_REPORT_LANG="en"
